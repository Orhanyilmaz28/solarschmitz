# Kopieren nach .env.local und ausfüllen.

# Öffentliche Adresse des Shops (für Metadaten, Sitemap, Links in E-Mails)
NEXT_PUBLIC_SITE_URL=https://www.sonnenwerk.de

# Checkout bleibt gesperrt, bis Zahlung und Backend korrekt angebunden sind.
# Erst auf "true" setzen, wenn PAYMENT_PROVIDER konfiguriert und getestet ist.
CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=

# Zugang zum Admin-Bereich (/admin). Ohne diese Werte ist /admin in Produktion gesperrt.
ADMIN_USER=
ADMIN_PASSWORD=

# Lieferant eforu (Zugangsdaten vom Lieferanten anfordern)
SUPPLIER_EFORU_API_URL=
SUPPLIER_EFORU_API_KEY=
SUPPLIER_EFORU_FEED_URL=
SUPPLIER_EFORU_ORDER_EMAIL=

# Gemeinsames Geheimnis für Versandstatus-Webhooks der Lieferanten
SUPPLIER_WEBHOOK_SECRET=

# Kontaktformular: Ziel-Webhook (Mail-Dienst, Ticketsystem, Automation). Ohne URL antwortet das Formular ehrlich mit „noch nicht angebunden“.
CONTACT_WEBHOOK_URL=

# Widerrufsfunktion (§ 356a BGB): Ziel-Webhook. Der angebundene Dienst muss die Eingangsbestätigung
# (Feld receiptText) unverzüglich per E-Mail an receiptTo schicken und den Shop informieren.
WITHDRAWAL_WEBHOOK_URL=
